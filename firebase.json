{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git",
      ".git/**",
      ".firebase/**",
      ".gitignore",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "_*",
      "sass/**",
      "Resume.pdf",
      "*.docx",
      "bdd-headshot.jpeg",
      "firebase-debug.log"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|jpg|jpeg|png|svg|woff|woff2|ttf|eot|otf|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "redirects": [
      {
        "regex": "^/projections(?:/(?P<path>.*))?$",
        "destination": "https://briandaviddavidson.github.io/projections/:path",
        "type": 301
      },
      {
        "regex": "^/git-and-github(?:/(?P<path>.*))?$",
        "destination": "https://briandaviddavidson.github.io/git-and-github/:path",
        "type": 301
      },
      {
        "regex": "^/d3-maptime(?:/(?P<path>.*))?$",
        "destination": "https://briandaviddavidson.github.io/d3-maptime/:path",
        "type": 301
      }
    ]
  }
}
